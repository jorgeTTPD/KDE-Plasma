#!/bin/bash
# bspwmrc — stack bspwm + sxhkd + picom + polybar (X11)
# Logs en ~/.local/state/bspwm/

STATE="$HOME/.local/state/bspwm"
mkdir -p "$STATE"

start() { # start <proceso> <comando...>: reinicia con guard y log
  local proc="$1"; shift
  pkill -x "$proc" 2>/dev/null
  "$@" >>"$STATE/$proc.log" 2>&1 &
}

# --- Atajos y notificaciones ---
start sxhkd sxhkd -c ~/.config/sxhkd/sxhkdrc
start dunst dunst

# --- Touchpad (tap-to-click + velocidad) ---
xinput list | grep -i "touchpad" | cut -d '=' -f 2 | cut -f 1 | while read -r id; do
  xinput set-prop "$id" "libinput Tapping Enabled" 1
  xinput set-prop "$id" "libinput Accel Speed" 0.5
done &

# Gestos del touchpad (tres dedos)
libinput-gestures-setup restart >>"$STATE/libinput-gestures.log" 2>&1 &

# Recursos X
xrdb -merge ~/.Xresources 2>>"$STATE/xrdb.log" &

# Portapapeles + tema Qt
export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORMTHEME=qt6ct
start greenclip greenclip daemon

# Compositor (sin -b: el & de start() ya lo daemoniza y captura su log)
start picom picom --config ~/.config/picom/picom.conf

# Barra
~/.config/polybar/launch.sh >>"$STATE/polybar.log" 2>&1 &

# --- Monitores y escritorios ---
bspc monitor -d I II III IV V

# Bordes y gaps
bspc config border_width 0
bspc config window_gap 10
bspc config split_ratio 0.50
bspc config focus_follows_pointer true
bspc config automatic_scheme longest_side
bspc config initial_polarity second_child
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config top_padding 28

# Puntero estilo Hyprland (super + click para mover/redimensionar)
bspc config pointer_modifier super
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

# --- Reglas de ventanas ---
bspc rule -a ffplay state=floating sticky=on focus=off layer=below
bspc rule -a Yad:yad state=floating sticky=on top=on focus=off rectangle=660+35+600+22
bspc rule -a Pavucontrol state=floating sticky=on
bspc rule -a File-roller state=floating
bspc rule -a Nm-connection-editor state=floating

# Menu de sistema (Super+S): flotante anclado a la izquierda (~42% del ancho, min. 430px)
sysmenu_rect() {
  local res w h pw
  res="$(xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}')"
  w="${res%x*}"; h="${res#*x}"
  case "$w$h" in ""|*[!0-9]*) w=1366; h=768 ;; esac
  pw=$(( w * 42 / 100 )); [ "$pw" -lt 430 ] && pw=430
  echo "${pw}x$(( h - 40 ))+4+30"
}
bspc rule -a URxvt:sysmenu-term state=floating sticky=on rectangle="$(sysmenu_rect)" focus=on

# --- Fondo de pantalla (aleatorio cada 10 min) ---
pkill -x xwinwrap 2>/dev/null; pkill -x ffplay 2>/dev/null
rm -f /tmp/wallpaper-video.pid
~/.config/scripts/wallpaper.sh daemon >>"$STATE/wallpaper.log" 2>&1 &

# Miniaturas de escritorios para el overview (Super+Tab)
pkill -f "[d]esktop-thumbs-daemon.sh" 2>/dev/null
~/.config/scripts/desktop-thumbs-daemon.sh >>"$STATE/desktop-thumbs.log" 2>&1 &

# --- Auto-lock y apagado de pantalla tras 7 min ---
xset s 420 420
xset dpms 420 420 420
start xss-lock xss-lock -- betterlockscreen -l -e -f

# --- Puente de audio Meet (persistente) ---
~/.config/scripts/audiomenu.sh ensure >>"$STATE/audiomenu.log" 2>&1
if ! tmux has-session -t meet-bridge 2>/dev/null; then
    tmux new-session -d -s meet-bridge "$HOME/.config/scripts/meet-bridge-ensure.sh"
fi
